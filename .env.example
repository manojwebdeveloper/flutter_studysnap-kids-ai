# ─────────────────────────────────────────────────────────
# StudySnap Kids AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────

# Google Gemini API (generates study content from scanned worksheets)
# Get a key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude API (legacy — no longer wired into generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-sonnet-4-6

# App config
APP_NAME=StudySnap Kids AI
APP_ENV=development  # development | staging | production

# Free plan limits
FREE_SCAN_LIMIT=3

# Subscription (RevenueCat)
REVENUECAT_API_KEY_IOS=your_revenuecat_ios_key
REVENUECAT_API_KEY_ANDROID=your_revenuecat_android_key
PREMIUM_MONTHLY_PRODUCT_ID=studysnap_premium_monthly

# Analytics (optional — add later)
# MIXPANEL_TOKEN=
# FIREBASE_PROJECT_ID=
